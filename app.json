{
    "package_id": "com.evenrun.g2v2",
    "edition": "202601",
    "name": "Run",
    "version": "1.2.5",
    "min_app_version": "2.0.0",
    "min_sdk_version": "0.0.7",
    "entrypoint": "index.html",
    "permissions": [
        {
            "name": "network",
            "desc": "Required to sync activities with Strava and load map tiles.",
            "whitelist": [
                "https://*.openstreetmap.org",
                "https://*.strava.com",
                "https://*.cartocdn.com"
            ]
        },
        {
            "name": "location",
            "desc": "Required to track your run and show your position on the map."
        }
    ],
    "supported_languages": [
        "en"
    ]
}